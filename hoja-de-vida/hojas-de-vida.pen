                            {
                              "type": "text",
                              "id": "k07vq",
                              "name": "Diseñador visual y especialista en Geren",
                              "context": "p",
                              "fill": "#17121a",
                              "textGrowth": "fixed-width-height",
                              "width": "fill_container",
                              "height": 105.38,
                              "content": "Diseñador visual y especialista en Gerencia de Marca con más de diez años creando sistemas de marca, campañas y piezas editoriales para marcas B2B, educación y cultura. En Magneto 365 escribí y diseñé el manual de marca B2B, definí el concepto visual de sus campañas y maqueté en Webflow su sitio corporativo. Siete años formando diseñadores me enseñaron a convertir cada solución en reglas que un equipo entero puede seguir.",
                              "lineHeight": 1.48,
                              "fontFamily": "Raleway",
                              "fontSize": 11.87,
                              "fontWeight": "normal"
                            }
